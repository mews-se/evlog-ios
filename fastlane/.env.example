# Copy to fastlane/.env and fill in. That file is gitignored.
#
# Key ID and the .p8 file come from App Store Connect ->
# Users and Access -> Integrations -> App Store Connect API.
# The .p8 can only be downloaded once. Issuer ID is the UUID
# shown above the key list on the same page.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
